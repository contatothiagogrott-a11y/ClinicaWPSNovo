// Schema completo do sistema da clínica.
// Campos que terminam em "Enc" guardam texto CRIPTOGRAFADO (AES-256-GCM)
// em base64. A criptografia/decriptação acontece na camada da API
// (api/_lib/crypto.ts), nunca no banco. O Prisma só vê strings opacas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Conexão POOLED (com "-pooler" no endereço). É a que a aplicação usa no
  // dia a dia: em ambiente serverless, cada requisição pode abrir uma conexão
  // nova, e o pooler do Neon evita estourar o limite do banco.
  url = env("DATABASE_URL")

  // Conexão DIRETA (sem "-pooler"). Usada SOMENTE para migrations.
  //
  // Por que isso é obrigatório: o pooler do Neon é um PgBouncer em modo
  // transação, que não suporta os comandos de bloqueio e as sessões longas de
  // que o Prisma Migrate precisa. Rodar `prisma migrate deploy` pela conexão
  // pooled falha — inclusive durante o build na Vercel.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERVISOR
  ADMIN
  PSICO
}

enum ClientStatus {
  FILA_ESPERA
  TRIAGEM
  TRIADOS
  EM_ATENDIMENTO
  FINALIZADO
  // Caso encerrado SEM atendimento: a pessoa entrou na fila mas não houve
  // serviço prestado (não retornou o contato, desistiu, número inválido).
  //
  // Existe separado de FINALIZADO por três razões:
  //  1. FINALIZADO significa serviço prestado e encerrado — é dele que corre o
  //     prazo de guarda do registro documental (Res. CFP nº 001/2009). Sem
  //     atendimento não há fato gerador dessa obrigação.
  //  2. As métricas do setor somam EM_ATENDIMENTO + FINALIZADO como casos
  //     atendidos. Misturar quem nunca foi atendido inflaria o indicador.
  //  3. Quem não foi atendido não tem prontuário aberto, logo não recebe
  //     número de prontuário.
  //
  // O dado é preservado: se a pessoa procurar o setor de novo, o histórico
  // mostra que ela já esteve na fila antes.
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum ConfigType {
  AFFILIATION
  ALLOCATION
  ROOM
  TAG
}

enum ClinicalDocumentType {
  ANAMNESE_RISCO
  URGENCIA
  ATESTADO
}

// Categoria da entrada de auditoria. Serve para separar, na leitura, o que é
// movimentação de cadastro do que é metainformação clínica (que nunca contém
// conteúdo de prontuário — ver api/_lib/audit.ts).
// Flexão de gênero do título profissional.
//
// Não é preciosismo: documentos psicológicos são assinados com o título e o
// CRP do profissional (Resolução CFP nº 06/2019), e um atestado que diz
// "Psicólogo Maria Silva" está identificando errado quem o emitiu.
//
// Quando não informado, os documentos usam a forma neutra "Psicólogo(a)" —
// ninguém é obrigado a declarar gênero para usar o sistema.
enum Gender {
  FEMININO
  MASCULINO
  NAO_INFORMADO
}

enum HistoryCategory {
  CADASTRO
  CLINICO
  DOCUMENTO
  TRANSFERENCIA
  FLUXO
  SISTEMA
}

enum InstrumentLogType {
  CONSUMPTION
  ADJUSTMENT
  INITIAL
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              Role      @default(PSICO)

  title             String?
  gender            Gender    @default(NAO_INFORMADO)
  institutionalLink String?
  birthDate         DateTime?
  matricula         String?
  crp               String?
  color             String?
  capacity          Json?

  // Toda senha criada por terceiro (Supervisor/Admin) nasce provisória: o
  // titular é obrigado a trocá-la no primeiro acesso. LGPD Art. 46 + boa
  // prática de não-repúdio: a credencial precisa ser conhecida só pelo titular,
  // caso contrário a assinatura do prontuário perde valor probatório.
  mustChangePassword   Boolean   @default(true)
  lastPasswordChangeAt DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignedClients   Client[]          @relation("AssignedPsico")
  sessions          SessionRecord[]
  groupsLed         Group[]
  groupRecords      GroupRecord[]
  appointments      Appointment[]
  instrumentLogs    InstrumentLog[]
  instrumentApps    InstrumentApplication[]
  historyLogs       HistoryLog[]
  accessLogs        AccessLog[]
  pushSubscriptions PushSubscription[]
  clinicalDocuments ClinicalDocument[]
  groupClientNotes  GroupClientNote[]
}

model Client {
  id                     String        @id @default(uuid())
  /**
   * Número do prontuário.
   *
   * NULO enquanto o caso está na fila de espera: quem ainda não foi atendido
   * não tem prontuário aberto, logo não tem número. É atribuído pelo servidor,
   * de forma sequencial e atômica, quando o caso sai da fila (ver
   * `assignProtocolNumber` em api/_lib/app.ts).
   */
  protocolNumber         String?
  signedAgreement        Boolean       @default(false)

  // Dados pessoais sensíveis (LGPD) - criptografados em repouso
  fullNameEnc              String
  whatsappEnc              String
  birthDateEnc             String
  emergencyContactNameEnc  String
  emergencyContactPhoneEnc String
  emergencyContactRelationshipEnc String @default("")
  residenceCityNeighborhoodEnc    String @default("")
  helpRequestEnc                  String @default("")
  medicationsEnc                  String @default("")
  contactObservationsEnc          String @default("")

  registrationCode       String
  affiliation            String
  allocation             String
  dependencyType         String?
  dependencySponsor      String?
  tags                   String[]      @default([])
  dateIncluded           DateTime      @default(now())
  status                 ClientStatus  @default(FILA_ESPERA)
  priority               Priority?
  assignedPsicoId        String?
  assignedPsico          User?         @relation("AssignedPsico", fields: [assignedPsicoId], references: [id])
  maxSessions            Int           @default(0)
  completedSessions      Int           @default(0)
  defaultRoom            String?
  defaultTime            String?

  // Dados de admissão/fila de espera (planilha de inscrição)
  sector                 String?
  workShift              String?
  whatsappAuthorized     Boolean?
  previouslyAttended     Boolean?
  contactMadeByName      String?
  contactDate            DateTime?
  contactStatus          String?

  // --- Campos vindos dos formulários de fila de espera (importação) ---

  // Diagnóstico/CID informado pelo próprio paciente no formulário.
  // Criptografado: é dado de saúde, a categoria mais sensível da LGPD
  // (Art. 5º, II — "dado pessoal sensível"). Fica em campo próprio, e não
  // diluído em observações, justamente para poder ser tratado com regra
  // de acesso distinta no futuro.
  diagnosisEnc           String?

  // Ramal institucional (existe separado do celular em várias listas).
  extension              String?

  // Mês/ano de ingresso na ALESC (não obrigatório).
  alescEntryDate         DateTime?

  // --- Sinalização de revisão pós-importação ---
  //
  // Importar planilha de origens diferentes gera cadastro incompleto ou
  // duplicado. Em vez de recusar a linha (o que faria perder gente da fila)
  // ou aceitar em silêncio (o que espalha erro pelo prontuário), o registro
  // entra marcado e aparece filtrado na Fila de Espera até alguém conferir.
  needsReview            Boolean       @default(false)
  reviewNotes            String?

  // Motivo do encerramento sem atendimento (status CANCELADO).
  // Criptografado: pode conter informação sobre a situação da pessoa.
  cancellationReasonEnc  String?

  // Identifica o lote de importação, permitindo desfazer uma importação
  // inteira caso o mapeamento de colunas tenha saído errado.
  importBatchId          String?

  // TEMPORALIDADE DE GUARDA (Resolução CFP nº 001/2009, art. 4º, §1º):
  // o registro documental deve ser guardado por no mínimo 5 anos após o
  // encerramento. Para crianças e adolescentes o prazo é maior — a regra de
  // cálculo fica em api/_lib/retention.ts e é gravada aqui no encerramento.
  finalizedAt            DateTime?
  retentionUntil         DateTime?
  disposedAt             DateTime?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  history                HistoryLog[]
  accessLogs             AccessLog[]
  sessions               SessionRecord[]
  appointments           Appointment[]
  instrumentApps         InstrumentApplication[]
  groupMemberships       GroupMember[]
  clinicalDocuments      ClinicalDocument[]
  groupAttendances       GroupAttendance[]
  groupClientNotes       GroupClientNote[]

  @@index([status])
  @@index([assignedPsicoId])
  @@index([needsReview])
  @@index([importBatchId])
}

// Trilha de auditoria de ESCRITA. É append-only por decisão de projeto: não
// existe rota de UPDATE nem de DELETE para este modelo em lugar nenhum da API,
// nem para o Supervisor. Um log editável não serve como prova.
//
// SIGILO: `detailsEnc` nunca recebe conteúdo clínico. Para prontuários grava-se
// apenas a metainformação ("Prontuário registrado por X em <data>").
model HistoryLog {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime        @default(now())
  actorId     String
  actor       User            @relation(fields: [actorId], references: [id])
  action      String
  category    HistoryCategory @default(CADASTRO)
  detailsEnc  String?

  @@index([clientId])
  @@index([category])
}

// Inscrição de um DISPOSITIVO para receber notificações push.
//
// Uma pessoa pode ter várias (celular + computador), por isso a chave é o
// endpoint, não o usuário.
//
// Sobre o conteúdo: a mensagem enviada é criptografada de ponta a ponta pelo
// protocolo Web Push (VAPID + aes128gcm). O servidor do Google/Apple entrega
// o pacote sem conseguir lê-lo. Ainda assim, o TEXTO EXIBIDO aparece na tela
// de bloqueio do aparelho — por isso ele nunca identifica paciente
// (ver api/_lib/push.ts).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // URL opaca gerada pelo navegador. Guardada em claro porque é a chave de
  // busca e de deduplicação; não contém dado de paciente.
  endpoint  String   @unique
  p256dh    String
  auth      String

  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  // Inscrições que falham repetidamente são removidas automaticamente.
  failureCount Int    @default(0)

  @@index([userId])
}

// Trilha de auditoria de LEITURA/EXPORTAÇÃO. Responde "quem viu o quê e
// quando" — exigência prática de prestação de contas da LGPD (Art. 6º, X) e
// do controle de acesso ao prontuário previsto na Resolução CFP nº 001/2009.
// O IP é guardado apenas como hash com sal (nunca em claro).
model AccessLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  action    String
  resource  String
  ipHash    String?

  @@index([clientId])
  @@index([actorId])
  @@index([at])
}

model SessionRecord {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psicoId       String
  psico         User      @relation(fields: [psicoId], references: [id])
  date          DateTime
  notesEnc      String    @default("")
  privateNotesEnc String  @default("") // rascunho visível SÓ para o profissional que atendeu (nunca sai da API para outros papéis)
  isDraft       Boolean   @default(true)
  status        String?
  groupId       String?
  appointmentId String?
  attendance    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  versions      RecordVersion[]

  @@index([clientId])
  @@index([psicoId])
}

model RecordVersion {
  id            String        @id @default(uuid())
  sessionId     String
  session       SessionRecord @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  oldContentEnc String
  savedAt       DateTime      @default(now())
}

model Group {
  id             String    @id @default(uuid())
  name           String
  objective      String
  methodology    String?
  frequency      String?
  criteria       String?
  createdAt      DateTime  @default(now())
  isActive       Boolean   @default(true)
  psychologistId String
  psychologist   User      @relation(fields: [psychologistId], references: [id])

  members        GroupMember[]
  records        GroupRecord[]
  appointments   Appointment[]
  clientNotes    GroupClientNote[]
}

model GroupMember {
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([groupId, clientId])
}

model GroupRecord {
  id          String   @id @default(uuid())
  contentEnc  String
  sessionDate DateTime
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  isDraft     Boolean  @default(true)

  attendances GroupAttendance[]
}

// Presença de cada integrante na sessão de grupo (independente do prontuário
// individual que é gerado automaticamente a partir dela).
model GroupAttendance {
  id            String      @id @default(uuid())
  groupRecordId String
  groupRecord   GroupRecord @relation(fields: [groupRecordId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status        String // COMPARECEU | FALTA_JUSTIFICADA | FALTA_INJUSTIFICADA | PENDENTE

  @@unique([groupRecordId, clientId])
}

model ConfigItem {
  id       String     @id @default(uuid())
  type     ConfigType
  name     String
  isActive Boolean    @default(true)

  @@index([type])
}

model Appointment {
  id            String    @id @default(uuid())
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  psicoId       String
  psico         User      @relation(fields: [psicoId], references: [id])
  roomId        String
  date          DateTime
  time          String
  endTime       String?
  seriesId      String?
  recurrence    String?
  sessionNumber Int?
  attendance    String?   @default("PENDENTE")

  // Momento em que o lembrete por push foi enviado.
  // Existe para IDEMPOTÊNCIA: o disparador externo bate na rota a cada 15
  // minutos, e sem esta marca o mesmo lembrete sairia várias vezes.
  reminderSentAt DateTime?

  @@index([date])
  @@index([psicoId])
}

model Instrument {
  id           String                   @id @default(uuid())
  name         String
  sheetCount   Int                      @default(0)
  logs         InstrumentLog[]
  applications InstrumentApplication[]
}

model InstrumentLog {
  id             String            @id @default(uuid())
  instrumentId   String
  instrument     Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date           DateTime          @default(now())
  type           InstrumentLogType
  amount         Int
  newCount       Int
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  protocolNumber String?
  reason         String?
}

model InstrumentApplication {
  id           String     @id @default(uuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  psychoId     String
  psycho       User       @relation(fields: [psychoId], references: [id])
  purposeEnc   String     @default("")
  createdAt    DateTime   @default(now())

  entries      InstrumentApplicationEntry[]
}

// Cada aplicação pode ter várias datas/descrições (ex: o mesmo teste aplicado
// em dias diferentes) sem consumir outra unidade do estoque — só a criação
// da InstrumentApplication em si consome 1 unidade.
model InstrumentApplicationEntry {
  id             String                @id @default(uuid())
  applicationId  String
  application    InstrumentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  date           DateTime
  descriptionEnc String
}

// Documentos clínicos formais e imprimíveis: Anamnese + Avaliação de
// Fatores de Risco e Proteção (unificados, pois se referenciam), e
// Atendimento de Urgência. Todo o conteúdo do formulário fica em um único
// campo JSON criptografado (dataEnc) — flexível o bastante para os muitos
// campos de cada formulário sem precisar de uma coluna por campo.
model ClinicalDocument {
  id          String               @id @default(uuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        ClinicalDocumentType
  dataEnc     String
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([clientId])
}

// Anotação do psicólogo de um GRUPO sobre um paciente específico daquele
// grupo — útil quando o paciente faz terapia individual com um profissional
// diferente do psicólogo do grupo. Uma anotação por (grupo, autor, paciente).
model GroupClientNote {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  contentEnc String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([groupId, clientId, authorId])
}
